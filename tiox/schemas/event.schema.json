{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threat-ioc-platform.local/schemas/event/1.0.0.json",
  "title": "Canonical Event",
  "description": "Normalized security event. All connectors emit this shape so any two observations can be joined on shared entities.",
  "type": "object",
  "required": [
    "event_id",
    "ts",
    "ingest_ts",
    "source",
    "type",
    "severity"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Dedupe key. Stable across re-ingest of the same fact."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the observation happened (UTC)."
    },
    "ingest_ts": {
      "type": "string",
      "format": "date-time",
      "description": "When this platform learned about it (UTC)."
    },
    "source": {
      "type": "string",
      "description": "Connector that produced this, e.g. 'agent', 'edr', 'stix'."
    },
    "type": {
      "type": "string",
      "enum": [
        "file",
        "process",
        "network_conn",
        "dns",
        "auth",
        "registry",
        "threat_hit",
        "alert",
        "incident",
        "agent_status"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "user": {
      "type": [
        "string",
        "null"
      ]
    },
    "entities": {
      "type": "object",
      "description": "Pivot surface. Keys are EntityType values.",
      "propertyNames": {
        "enum": [
          "file_hash",
          "file_path",
          "file_name",
          "ip",
          "domain",
          "url",
          "process",
          "registry_key",
          "user",
          "host",
          "mutex",
          "scheduled_task",
          "cert",
          "email"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "title": {
      "type": "string",
      "maxLength": 512
    },
    "description": {
      "type": "string"
    },
    "rule_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Detection rule that fired, if any. Sigma/YARA/builtin id."
    },
    "tlp": {
      "type": "string",
      "enum": [
        "white",
        "green",
        "amber",
        "amber+strict"
      ],
      "default": "amber",
      "description": "Sensitivity label; enforces sharing boundaries."
    },
    "raw": {
      "type": "object",
      "description": "Original connector payload, unmodified."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "network_conn"
          }
        }
      },
      "then": {
        "description": "Network events should carry at least one endpoint entity.",
        "anyOf": [
          {
            "properties": {
              "entities": {
                "required": [
                  "ip"
                ]
              }
            }
          },
          {
            "properties": {
              "entities": {
                "required": [
                  "domain"
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "$comment": "generated from tiox.schemas.event SCHEMA_VERSION=1.0.0"
}
