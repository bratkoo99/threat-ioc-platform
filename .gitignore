# Compiled binaries
ioc_scanner
*.o

# Python cache
__pycache__/
*.pyc
*.pyo

# TLS material - generated locally, never committed
certs/
*.key
*.pem
.agent_key
*.secret

# Local data: threat intel, IOC lists, and anything else that changes per
# deployment or that you would rather not publish. The platform code that
# *consumes* these is tracked; the data itself is not.
data/
*.csv

# Runtime state (regenerated)
*.db
*.db-wal
*.db-shm
inventory.json
incidents.json
logs/
reports/
ioc_databases/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.bak
*~
